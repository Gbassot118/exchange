{% extends 'base.html.twig' %}

{% block title %}{{ session.title }} - Documentation Collaborative{% endblock %}

{% block body %}
<div class="flex h-screen"
     id="session-container"
     data-session-id="{{ session.id }}"
     data-participant-id="{{ participant.id }}">

    <!-- Sidebar - Navigation des documents -->
    <aside class="w-80 bg-white border-r border-gray-200 flex flex-col">
        {% include 'session/_sidebar.html.twig' %}
    </aside>

    <!-- Zone principale -->
    <main class="flex-1 flex flex-col overflow-hidden">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 px-6 py-3" id="session-header">
            {% include 'session/_header.html.twig' %}
        </header>

        <!-- Contenu du document -->
        <div class="flex-1 overflow-auto p-6" id="document-content">
            {% if currentDocument %}
                {% include 'document/_view.html.twig' with {document: currentDocument} %}
            {% else %}
                {% include 'session/_welcome.html.twig' %}
            {% endif %}
        </div>
    </main>

    <!-- Resize handle -->
    <div id="resize-handle" class="w-1 bg-gray-200 hover:bg-blue-400 cursor-col-resize transition-colors flex-shrink-0"></div>

    <!-- Panel annotations (resizable) -->
    <aside class="bg-white border-l border-gray-200 flex flex-col" id="annotations-panel" style="width: 320px; min-width: 280px; max-width: 900px;">
        {% include 'annotation/_panel.html.twig' %}
    </aside>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    const sessionId = '{{ session.id }}';
    const participantId = '{{ participant.id }}';
    const mercureUrl = '{{ mercure_url }}';

    // Start heartbeat
    startHeartbeat(sessionId, participantId);

    // Store last presence data for re-applying after sidebar refresh
    let lastPresenceData = [];

    // ====== COLLAPSE/EXPAND FUNCTIONALITY ======
    const COLLAPSED_DOCS_KEY = `collapsed-docs-${sessionId}`;

    function getCollapsedDocs() {
        try {
            const stored = localStorage.getItem(COLLAPSED_DOCS_KEY);
            return stored ? new Set(JSON.parse(stored)) : new Set();
        } catch (e) {
            return new Set();
        }
    }

    function saveCollapsedDocs(collapsedSet) {
        localStorage.setItem(COLLAPSED_DOCS_KEY, JSON.stringify([...collapsedSet]));
    }

    function toggleDocumentCollapse(docId) {
        const children = document.getElementById(`children-${docId}`);
        const button = document.querySelector(`button[data-doc-id="${docId}"]`);
        if (!children) return;

        const collapsed = getCollapsedDocs();

        if (collapsed.has(docId)) {
            // Expand
            collapsed.delete(docId);
            children.classList.remove('hidden');
            if (button) {
                button.querySelector('.chevron-icon').style.transform = 'rotate(90deg)';
            }
        } else {
            // Collapse
            collapsed.add(docId);
            children.classList.add('hidden');
            if (button) {
                button.querySelector('.chevron-icon').style.transform = 'rotate(0deg)';
            }
        }

        saveCollapsedDocs(collapsed);
    }

    function restoreCollapsedState() {
        const collapsed = getCollapsedDocs();
        collapsed.forEach(docId => {
            const children = document.getElementById(`children-${docId}`);
            const button = document.querySelector(`button[data-doc-id="${docId}"]`);
            if (children) {
                children.classList.add('hidden');
            }
            if (button) {
                button.querySelector('.chevron-icon').style.transform = 'rotate(0deg)';
            }
        });

        // Set expanded state for non-collapsed documents
        document.querySelectorAll('.children-container').forEach(ul => {
            const docId = ul.id.replace('children-', '');
            if (!collapsed.has(docId)) {
                const button = document.querySelector(`button[data-doc-id="${docId}"]`);
                if (button) {
                    button.querySelector('.chevron-icon').style.transform = 'rotate(90deg)';
                }
            }
        });
    }

    // Make toggleDocumentCollapse available globally (called from onclick in template)
    window.toggleDocumentCollapse = toggleDocumentCollapse;

    // ====== DRAG AND DROP DOCUMENT REORDERING ======
    function initDocumentSortable() {
        document.querySelectorAll('.sortable-list').forEach(container => {
            // Destroy existing instance if any
            if (container.sortableInstance) {
                container.sortableInstance.destroy();
            }

            const parentId = container.dataset.parentId;

            container.sortableInstance = new Sortable(container, {
                group: {
                    name: `level-${parentId}`,
                    pull: false,
                    put: false
                },
                handle: '.drag-handle',
                animation: 150,
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                filter: '#empty-docs-message',

                onEnd: function(evt) {
                    if (evt.oldIndex === evt.newIndex) return;

                    const listItems = Array.from(evt.to.children).filter(el => el.dataset.docId);

                    // Update sort order for all items to ensure proper ordering
                    const updates = listItems.map((item, index) => ({
                        id: item.dataset.docId,
                        sortOrder: index * 10
                    }));

                    updateAllDocumentSortOrders(updates);
                }
            });
        });
    }

    async function updateAllDocumentSortOrders(updates) {
        try {
            // Update all documents in parallel
            const promises = updates.map(update =>
                fetch(`/api/mcp/documents/${update.id}`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Agent-Id': participantId
                    },
                    body: JSON.stringify({ sort_order: update.sortOrder })
                })
            );

            const responses = await Promise.all(promises);
            const failed = responses.some(r => !r.ok);

            if (failed) {
                console.error('Failed to update some sort orders');
                refreshDocumentTree();
            }
        } catch (error) {
            console.error('Error updating sort orders:', error);
            refreshDocumentTree();
        }
    }

    // Initialize collapsed state and sortable on page load
    document.addEventListener('DOMContentLoaded', () => {
        restoreCollapsedState();
        initDocumentSortable();
    });

    // ====== PRESENCE INDICATORS IN SIDEBAR ======
    function updateDocumentPresenceIndicators(participants) {
        // Clear all presence indicators
        document.querySelectorAll('.presence-indicators').forEach(el => {
            el.innerHTML = '';
        });

        // Group participants by document_id
        const byDocument = {};
        participants.forEach(p => {
            if (p.current_document_id) {
                if (!byDocument[p.current_document_id]) {
                    byDocument[p.current_document_id] = [];
                }
                byDocument[p.current_document_id].push(p);
            }
        });

        // Display indicators for each document
        for (const [docId, viewers] of Object.entries(byDocument)) {
            const container = document.getElementById(`presence-doc-${docId}`);
            if (container) {
                // Show max 4 indicators, then +N
                const maxVisible = 4;
                const visibleViewers = viewers.slice(0, maxVisible);
                const remaining = viewers.length - maxVisible;

                let html = '';
                visibleViewers.forEach(p => {
                    const initial = p.pseudo.charAt(0).toUpperCase();
                    html += `<span class="w-5 h-5 rounded-full inline-flex items-center justify-center flex-shrink-0 text-white text-xs font-medium"
                                  style="background-color: ${p.color}"
                                  title="${p.pseudo}">${initial}</span>`;
                });

                if (remaining > 0) {
                    html += `<span class="text-xs text-gray-500 ml-0.5" title="${viewers.slice(maxVisible).map(p => p.pseudo).join(', ')}">+${remaining}</span>`;
                }

                container.innerHTML = html;
            }
        }
    }

    // Connect to Mercure SSE for real-time updates
    const topics = [
        `/sessions/${sessionId}`,
        `/sessions/${sessionId}/presence`,
        `/sessions/${sessionId}/documents`,
        `/sessions/${sessionId}/annotations`,
        `/sessions/${sessionId}/decisions`
    ];

    const url = new URL(mercureUrl);
    topics.forEach(topic => url.searchParams.append('topic', topic));

    const eventSource = new EventSource(url, { withCredentials: false });

    // Helper function to refresh sidebar document tree
    function refreshDocumentTree() {
        htmx.ajax('GET', `/session/${sessionId}/sidebar`, {
            target: '#document-tree',
            swap: 'innerHTML'
        }).then(() => {
            // Restore collapsed state after refresh
            restoreCollapsedState();
            // Re-initialize sortable after refresh
            initDocumentSortable();
            // Re-apply presence indicators
            if (lastPresenceData.length > 0) {
                updateDocumentPresenceIndicators(lastPresenceData);
            }
        }).catch(e => console.error('Failed to refresh document tree:', e));
    }

    // Helper function to refresh current document content
    function refreshCurrentDocument(docId, docSlug) {
        const currentDocId = document.body.dataset.currentDocumentId;
        if (currentDocId && docId === currentDocId && docSlug) {
            htmx.ajax('GET', `/session/${sessionId}/document/${docSlug}`, {
                target: '#document-content',
                swap: 'innerHTML'
            }).catch(e => console.error('Failed to refresh document:', e));
        }
    }

    // Helper function to refresh annotations panel
    function refreshAnnotations(docId) {
        const annotationsPanel = document.getElementById('annotations-list');
        if (annotationsPanel) {
            const currentDocId = document.body.dataset.currentDocumentId;
            if (!currentDocId || docId === currentDocId) {
                htmx.ajax('GET', `/session/${sessionId}/annotations?document_id=${docId || ''}`, {
                    target: '#annotations-list',
                    swap: 'innerHTML'
                }).catch(e => console.error('Failed to refresh annotations:', e));
            }
        }
    }

    // Handle SSE event (named events use addEventListener, not onmessage)
    function handleSSEEvent(eventType, handler) {
        eventSource.addEventListener(eventType, function(event) {
            try {
                const message = JSON.parse(event.data);
                handler(message.data);
            } catch (e) {
                console.error('SSE parse error for', eventType, ':', e);
            }
        });
    }

    // Presence updates
    handleSSEEvent('presence.update', (data) => {
        lastPresenceData = data.participants;
        updatePresence(data.participants);
    });

    // Document events
    handleSSEEvent('document.created', (data) => {
        refreshDocumentTree();
        // Remove "Aucun document" message if present
        const emptyMsg = document.getElementById('empty-docs-message');
        if (emptyMsg) emptyMsg.remove();
    });

    handleSSEEvent('document.updated', (data) => {
        refreshDocumentTree();
        refreshCurrentDocument(data.id, data.slug);
    });

    handleSSEEvent('document.deleted', (data) => {
        refreshDocumentTree();
        // If viewing deleted document, show welcome screen
        const currentDocId = document.body.dataset.currentDocumentId;
        if (currentDocId && data.id === currentDocId) {
            htmx.ajax('GET', `/session/${sessionId}`, {
                target: '#document-content',
                swap: 'innerHTML',
                select: '#document-content'
            });
        }
    });

    // Annotation events
    handleSSEEvent('annotation.created', (data) => {
        refreshAnnotations(data.document_id);
    });

    handleSSEEvent('annotation.updated', (data) => {
        refreshAnnotations(data.document_id);
    });

    handleSSEEvent('annotation.resolved', (data) => {
        refreshAnnotations(data.document_id);
    });

    handleSSEEvent('annotation.deleted', (data) => {
        const annotationEl = document.getElementById(`annotation-${data.id}`);
        if (annotationEl) {
            annotationEl.remove();
        }
    });

    // Decision events - refresh decisions list for current document
    function refreshDecisions(documentId) {
        const currentDocId = document.body.dataset.currentDocumentId;
        const decisionsContainer = document.getElementById('decisions-container');
        const decisionsList = document.getElementById('decisions-list');

        // Only refresh if viewing the same document or if documentId matches
        if (decisionsContainer && (documentId === currentDocId || !documentId)) {
            // Show container if hidden
            decisionsContainer.classList.remove('hidden');

            htmx.ajax('GET', `/session/${sessionId}/decisions?document_id=${currentDocId || ''}`, {
                target: '#decisions-list',
                swap: 'outerHTML'
            }).catch(e => console.error('Failed to refresh decisions:', e));
        }
    }

    handleSSEEvent('decision.created', (data) => {
        refreshDecisions(data.document_id);
    });

    handleSSEEvent('decision.updated', (data) => {
        refreshDecisions(data.document_id);
    });

    handleSSEEvent('decision.deleted', (data) => {
        refreshDecisions(data.document_id);
    });

    handleSSEEvent('decision.status_changed', (data) => {
        refreshDecisions(data.linked_document_id);
    });

    handleSSEEvent('vote.received', (data) => {
        refreshDecisions(null); // Refresh all since vote doesn't include document_id
    });

    // Session status change
    handleSSEEvent('session.status_changed', (data) => {
        // Reload the page to update status indicators
        window.location.reload();
    });

    // Fallback for unnamed events (shouldn't happen with our Mercure setup)
    eventSource.onmessage = function(event) {
        // Ignored - all events should be named
    };

    eventSource.onerror = function(err) {
        console.error('SSE connection error:', err);
    };

    function updatePresence(participants) {
        // Update header presence indicators (avatars)
        const container = document.getElementById('presence-indicator');
        const countEl = document.getElementById('presence-count');
        if (container) {
            let html = '';
            participants.forEach(p => {
                html += `
                    <div class="relative group" title="${p.pseudo}">
                        <span class="w-8 h-8 rounded-full flex items-center justify-center text-white text-sm font-medium shadow-sm border-2 border-white"
                              style="background-color: ${p.color}">
                            ${p.pseudo.charAt(0).toUpperCase()}
                        </span>
                        <div class="absolute hidden group-hover:block top-full mt-1 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs rounded py-1 px-2 whitespace-nowrap z-20">
                            ${p.pseudo}
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        if (countEl) {
            countEl.textContent = participants.length + ' connecte(s)';
        }

        // Update document presence indicators in sidebar
        updateDocumentPresenceIndicators(participants);
    }

    // Cleanup on page leave
    window.addEventListener('beforeunload', () => {
        eventSource.close();
    });

    // Panel resize functionality
    (function() {
        const handle = document.getElementById('resize-handle');
        const panel = document.getElementById('annotations-panel');
        const STORAGE_KEY = 'annotations-panel-width';
        const MIN_WIDTH = 280;
        const MAX_WIDTH = 900;

        // Restore saved width
        const savedWidth = localStorage.getItem(STORAGE_KEY);
        if (savedWidth) {
            panel.style.width = Math.min(Math.max(parseInt(savedWidth), MIN_WIDTH), MAX_WIDTH) + 'px';
        }

        let isResizing = false;
        let startX, startWidth;

        handle.addEventListener('mousedown', (e) => {
            isResizing = true;
            startX = e.clientX;
            startWidth = panel.offsetWidth;
            document.body.style.cursor = 'col-resize';
            document.body.style.userSelect = 'none';
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!isResizing) return;
            const diff = startX - e.clientX; // Inverse car panel à droite
            const newWidth = Math.min(Math.max(startWidth + diff, MIN_WIDTH), MAX_WIDTH);
            panel.style.width = newWidth + 'px';
        });

        document.addEventListener('mouseup', () => {
            if (isResizing) {
                isResizing = false;
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                localStorage.setItem(STORAGE_KEY, panel.offsetWidth);
            }
        });
    })();
</script>
{% endblock %}
