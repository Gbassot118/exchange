<div class="bg-white border border-gray-200 rounded-lg p-4 mb-4 estimation-card"
     id="estimation-{{ estimation.id }}"
     data-estimation-id="{{ estimation.id }}">

    <!-- Header -->
    <div class="flex items-start justify-between mb-3">
        <div class="flex-1">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
                <h4 class="font-semibold text-gray-900">{{ estimation.title }}</h4>
            </div>
            {% if estimation.description %}
                <p class="text-sm text-gray-600 mt-1">{{ estimation.description }}</p>
            {% endif %}
        </div>
        <span class="px-2 py-1 text-xs rounded-full
            {% if estimation.isRevealed %}bg-green-100 text-green-700
            {% else %}bg-purple-100 text-purple-700{% endif %}">
            {% if estimation.status == 'closed' %}Terminé
            {% elseif estimation.isRevealed %}Révélé
            {% else %}En cours{% endif %}
        </span>
    </div>

    {% set currentVote = participant ? estimation.getVoteForParticipant(participant) : null %}
    {% set voteCount = estimation.votes|length %}

    {% if not estimation.isRevealed %}
        <!-- Voting phase - show who voted without values -->
        <div class="mb-4">
            <!-- Fibonacci buttons -->
            <div class="grid grid-cols-5 gap-2 mb-4">
                {% set fibonacciValues = ['0', '1', '2', '3', '5', '8', '13', '21', '?'] %}
                {% for value in fibonacciValues %}
                    {% set isVoted = currentVote and currentVote.value == value %}
                    <button hx-post="/session/{{ estimation.session.id }}/estimation/{{ estimation.id }}/vote"
                            hx-vals='{"value": "{{ value }}"}'
                            hx-target="#estimation-{{ estimation.id }}"
                            hx-swap="outerHTML"
                            class="py-3 px-2 text-center font-bold rounded-lg border-2 transition-all
                                   {{ isVoted ? 'border-purple-500 bg-purple-100 text-purple-700' : 'border-gray-200 hover:border-purple-300 hover:bg-purple-50 text-gray-700' }}
                                   {% if value == '?' %}col-span-1{% endif %}">
                        {{ value }}
                    </button>
                {% endfor %}
            </div>

            <!-- Voters indicator -->
            {% if voteCount > 0 %}
                <div class="flex flex-wrap gap-2 items-center text-sm text-gray-600 mb-3">
                    <span class="font-medium">Ont voté:</span>
                    {% for vote in estimation.votes %}
                        <span class="inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                            {{ vote.participant.pseudo }}
                        </span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <!-- Reveal button -->
        <div class="flex items-center justify-between pt-3 border-t border-gray-100">
            <span class="text-xs text-gray-500">
                {{ voteCount }} vote{{ voteCount > 1 ? 's' : '' }}
            </span>
            {% if voteCount > 0 %}
                <button hx-post="/session/{{ estimation.session.id }}/estimation/{{ estimation.id }}/reveal"
                        hx-target="#estimation-{{ estimation.id }}"
                        hx-swap="outerHTML"
                        hx-confirm="Révéler les votes ?"
                        class="px-4 py-2 text-sm font-medium text-white bg-purple-600 hover:bg-purple-700 rounded-md transition-colors flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    Révéler les votes
                </button>
            {% endif %}
        </div>

    {% else %}
        <!-- Revealed phase - show all votes and average -->
        <div class="space-y-3 mb-4">
            {% for vote in estimation.votes %}
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                    <span class="font-medium text-gray-700">{{ vote.participant.pseudo }}</span>
                    <span class="text-2xl font-bold {% if vote.value == '?' %}text-amber-500{% else %}text-purple-600{% endif %}">
                        {{ vote.value }}
                    </span>
                </div>
            {% endfor %}
        </div>

        <!-- Average -->
        {% set average = estimation.calculateAverage() %}
        <div class="flex items-center justify-between pt-3 border-t border-gray-100">
            <div class="flex items-center gap-4">
                <span class="text-xs text-gray-500">
                    {{ voteCount }} vote{{ voteCount > 1 ? 's' : '' }}
                </span>
                {% if average is not null %}
                    <span class="flex items-center gap-2 text-purple-600 font-semibold">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                        Moyenne: {{ average }}
                    </span>
                {% endif %}
            </div>
            <span class="flex items-center gap-1 text-xs text-green-600">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                Votes révélés
            </span>
        </div>
    {% endif %}
</div>
