<form hx-post="/session/{{ session.id }}/estimation/create"
      hx-target="#estimations-container"
      hx-swap="innerHTML"
      class="bg-white border border-gray-200 rounded-lg p-4 mb-4">
    <h4 class="font-semibold text-gray-900 mb-3">Nouveau chiffrage</h4>

    <div class="space-y-3">
        <div>
            <label for="estimation-title" class="block text-sm font-medium text-gray-700 mb-1">Titre</label>
            <input type="text"
                   id="estimation-title"
                   name="title"
                   required
                   placeholder="Ex: Story: Authentification OAuth"
                   class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500">
        </div>

        <div>
            <label for="estimation-description" class="block text-sm font-medium text-gray-700 mb-1">Description (optionnel)</label>
            <textarea id="estimation-description"
                      name="description"
                      rows="2"
                      placeholder="Détails sur l'élément à estimer..."
                      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-purple-500 focus:border-purple-500"></textarea>
        </div>

        {% if document is defined and document %}
            <input type="hidden" name="document_id" value="{{ document.id }}">
        {% endif %}
    </div>

    <div class="flex justify-end gap-2 mt-4">
        <button type="button"
                onclick="this.closest('form').remove()"
                class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800">
            Annuler
        </button>
        <button type="submit"
                class="px-4 py-2 text-sm font-medium text-white bg-purple-600 hover:bg-purple-700 rounded-md transition-colors">
            Créer le chiffrage
        </button>
    </div>
</form>
